generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model admin {
  user_id Int   @id
  users   users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model coach {
  user_id       Int             @id
  price_dkk     Int
  max_clients   Int?            @default(20)
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_to_coach user_to_coach[]
}

model comment {
  id        Int     @id @default(autoincrement())
  owner     Int?
  attach_id Int?
  msg       String? @db.VarChar(256)
  users     users?  @relation(fields: [owner], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exercise {
  id                        Int                         @id @default(autoincrement())
  name                      String                      @db.VarChar(30)
  description               String                      @db.VarChar(120)
  equipment                 equipment_type
  exercise_log              exercise_log[]
  exercise_to_muscle        exercise_to_muscle[]
  program_template_exercise program_template_exercise[]
}

model exercise_to_muscle {
  exercise_id   Int
  muscle_grp_id Int
  exercise      exercise     @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  muscle_group  muscle_group @relation(fields: [muscle_grp_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([exercise_id, muscle_grp_id])
}

model muscle_group {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(30)
  exercise_to_muscle exercise_to_muscle[]
}

model password {
  hash         String    @db.VarChar(256)
  user_id      Int       @unique
  last_updated DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([hash, user_id])
}

model program_template {
  id          Int                         @id @default(autoincrement())
  coach_id    Int
  name        String                      @db.VarChar(30)
  description String?                     @db.VarChar(120)
  created_at  DateTime                    @default(now()) @db.Timestamp(6)
  program_log program_log[]
  coach       users                       @relation("CoachProgramTemplates", fields: [coach_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercises   program_template_exercise[]
  assignments user_program_template[]
}

model program_template_exercise {
  id          Int              @id @default(autoincrement())
  template_id Int
  exercise_id Int
  order_nr    Int
  rest_timer  Int              @default(0)
  weight_kg   Int              @default(0)
  reps        Int              @default(0)
  exercise    exercise         @relation(fields: [exercise_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template    program_template @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([template_id, exercise_id, order_nr])
}

model user_program_template {
  id          Int              @id @default(autoincrement())
  user_id     Int
  template_id Int
  assigned_at DateTime         @default(now()) @db.Timestamp(6)
  template    program_template @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, template_id])
}

model program_log {
  user_id      Int
  date         DateTime         @default(now()) @db.Timestamp(6)
  id           Int              @id @default(autoincrement())
  note         String?          @db.VarChar(256)
  template_id  Int
  exercise_log exercise_log[]
  template     program_template @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exercise_log {
  id             Int         @id @default(autoincrement())
  reps           Int
  kg             Float
  exercise_id    Int
  program_log_id Int
  set_nr         Int
  exercise       exercise    @relation(fields: [exercise_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  program_log    program_log @relation(fields: [program_log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([program_log_id, exercise_id, set_nr])
}

model token {
  hash    String    @id @db.VarChar(256)
  user_id Int
  expires DateTime? @default(dbgenerated("(now() + '1 day'::interval)")) @db.Timestamp(6)
  users   users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_to_coach {
  user_id  Int   @id
  coach_id Int
  coach    coach @relation(fields: [coach_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  users    users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, coach_id])
}

model users {
  id                         Int                     @id @default(autoincrement())
  name                       String                  @db.VarChar(30)
  date_of_birth              DateTime?               @db.Date
  weight_kg                  Float?
  height_cm                  Float?
  email                      String                  @unique @db.VarChar(120)
  gender                     gender_type?
  picture                    String?                 @db.VarChar(120)
  admin                      admin?
  coach                      coach?
  comment                    comment[]
  password                   password?
  program_log                program_log[]
  coached_program_templates  program_template[]      @relation("CoachProgramTemplates")
  token                      token[]
  assigned_program_templates user_program_template[]
  user_to_coach              user_to_coach?
  weight_logs                weight_logs[]
}

model weight_logs {
  user_id   Int
  timestamp DateTime @default(now()) @db.Date
  weight    Float?
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, timestamp])
}

enum equipment_type {
  None
  Barbell
  Dumbbell
  Kettlebell
  Machine
  Plate
  Resistance_Band @map("Resistance Band")
  Suspension_Band @map("Suspension Band")
  Other
}

enum gender_type {
  male
  female
}
